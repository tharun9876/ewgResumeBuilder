# Create a free API key at https://openrouter.ai/settings/keys
# Keep this key on the server only. Never put it in index.html.
OPENROUTER_API_KEY=replace_me

# Recommended default: OpenRouter automatically selects a free model supporting JSON output.
# You may instead enter a specific currently available model ID ending in :free.
OPENROUTER_MODEL=openrouter/free

# Only the summary and, when needed, one long competency block are sent to AI.
# Role/education/skills mapping uses the source document locally.
OPENROUTER_SUMMARY_MAX_TOKENS=1000
OPENROUTER_MAX_EXTRACTION_CALLS=48
OPENROUTER_SUMMARY_TIMEOUT_SECONDS=45
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_SITE_URL=http://localhost:8000
OPENROUTER_APP_NAME=EWGCS Resume Builder
OPENROUTER_TIMEOUT_SECONDS=120

MAX_UPLOAD_MB=10
MAX_TEXT_CHARS=120000
MAX_DOCX_EXPANDED_BYTES=60000000
MAX_DOCX_XML_BYTES=60000000
MAX_DOCX_ZIP_ENTRIES=5000
LOG_LEVEL=INFO
